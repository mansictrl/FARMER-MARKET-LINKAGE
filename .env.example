# Database Configuration (PostgreSQL in Docker / SQLite in local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/farmer_market
# For local zero-dependency testing without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./farmer_market.db

# Security & Authentication
SECRET_KEY=b6692779-farmer-market-secret-jwt-key-super-secure-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Message Queue & Cache
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# External Integration Adapters
AGMARKNET_API_KEY=
# Open-Meteo Weather API is open-access & keyless (zero configuration required)
WEATHER_API_KEY=
SMS_GATEWAY_API_KEY=
WHATSAPP_API_KEY=

# AWS / MinIO S3 Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=agrimarket-documents
S3_REGION=us-east-1

# Server Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80
